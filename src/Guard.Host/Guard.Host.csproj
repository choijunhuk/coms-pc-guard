<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The service is Windows-only; this lets the portable CI job still compile it. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <AssemblyName>guard-service</AssemblyName>
    <RootNamespace>Guard.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Worker SDK publishes every *.json as content; the lock file is build input only. -->
    <Content Remove="packages.lock.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\Guard.Service\\Guard.Service.csproj" />
    <ProjectReference Include="..\\Guard.Windows\\Guard.Windows.csproj" />
  </ItemGroup>
</Project>
