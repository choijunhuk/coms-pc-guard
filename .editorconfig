root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.cs]
dotnet_analyzer_diagnostic.severity = warning
dotnet_diagnostic.CA*.severity = warning

# "Populate switch" fixes insert `throw new NotImplementedException()` arms ahead of an intentional
# default arm; dotnet format applied them silently and broke guard apply. Keep defaults explicit instead.
dotnet_diagnostic.IDE0010.severity = none
dotnet_diagnostic.IDE0072.severity = none
